# r30 security (2026-10): npm supply-chain worms (Shai-Hulud waves 2025-2026) spread through
# install-time lifecycle scripts. No Helm dependency needs one (package-lock.json has no
# hasInstallScript entry), so never run them. Playwright browsers are installed explicitly
# with `npx playwright install`. Remove only if a future dependency truly needs a build step.
ignore-scripts=true
# Exact versions only - a new dependency is pinned, never a floating ^/~ range.
save-exact=true
