{
  "//": "Lighthouse CI budgets for the static Helm front-end. Run with: npx @lhci/cli@0.14.x autorun (no committed dependency). Key budgets (performance, accessibility, FCP, LCP, TBT, CLS) are BLOCKING (error), set ~15% below scores measured locally on 2026-09-30 (3 runs each, simulated throttling). best-practices / SEO / TTI are advisory (warn). SEO is only budgeted for the indexable landing page: app pages are deliberately noindex (X-Robots-Tag), which Lighthouse's is-crawlable audit reports as an SEO failure. /dashboard is not collected: signed out it client-redirects to /login, so Lighthouse measured the login page twice (LHCI groups runs by final URL) - an authenticated Lighthouse run would be needed to budget app pages.",
  "ci": {
    "collect": {
      "startServerCommand": "node server.js",
      "startServerReadyPattern": "Blueprint Stage running",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/login",
        "http://127.0.0.1:4173/builder"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4173/(index)?$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3200
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 4500
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 300
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "interactive": [
              "warn",
              {
                "maxNumericValue": 5000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4173/login$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3200
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3500
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 300
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "interactive": [
              "warn",
              {
                "maxNumericValue": 5000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4173/builder$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.62
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 5000
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 5000
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 400
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "interactive": [
              "warn",
              {
                "maxNumericValue": 7500
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
